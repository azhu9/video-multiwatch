{
  "manifest_version": 3,
  "name": "Multiwatch",
  "version": "0.7.0",
  "description": "Track multiple live video tabs, watch one with audio, swap between them.",
  "permissions": ["tabs", "tabCapture", "activeTab", "storage", "contextMenus", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Multiwatch: track this tab"
  }
}
